# AI Insurance Assistant - Environment Configuration

# ==================== AI MODEL PROVIDER ====================
# Choose: "fallback", "ollama", "azure"
# Note: Azure OpenAI provides access to both GPT-4 and DeepSeek R1
MODEL_PROVIDER=azure

# ==================== AZURE OPENAI ====================
# Single Azure key provides access to both GPT-4 and DeepSeek R1
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Model Deployments (configure in Azure Portal)
# GPT-4 deployment name
AZURE_OPENAI_DEPLOYMENT=gpt-4
# DeepSeek R1 deployment name (optional, if available in your Azure resource)
AZURE_DEEPSEEK_DEPLOYMENT=deepseek-r1

# Choose which model to use
AZURE_MODEL_TYPE=gpt-4
# Options: "gpt-4", "gpt-4-turbo", "deepseek-r1"

# ==================== OLLAMA (Local) ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ==================== AI SETTINGS ====================
MAX_TOKENS=2000
TEMPERATURE=0.7
ENABLE_MARKDOWN=true
STRIP_REASONING_TAGS=true

# ==================== APPLICATION ====================
APP_NAME=AI Insurance Assistant
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ==================== DATABASE ====================
DATABASE_URL=sqlite+aiosqlite:///./insurance_assistant.db

# ==================== ADVANCED ====================
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
COLLECTION_NAME=insurance_faq

